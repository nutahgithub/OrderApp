generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider          = "mysql"
  url               = env("DATABASE_URL")
  shadowDatabaseUrl = env("SHADOW_DATABASE_URL")
}

enum TableStatus {
  AVAILABLE
  OCCUPIED
  DISABLED
}

enum OrderStatus {
  PENDING
  CONFIRMED
  PREPARING
  READY
  SERVED
  CANCELLED
  PAID
}

enum AdminRole {
  OWNER
  MANAGER
  STAFF
}

enum PaymentMethod {
  CASH
}

enum PaymentStatus {
  COMPLETED
}

enum IdempotencyAction {
  CREATE_QR_ORDER
  CONFIRM_PAYMENT
}

model Tenant {
  id              String            @id @default(cuid())
  name            String
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt
  admins          AdminUser[]
  branches        Branch[]
  tables          RestaurantTable[]
  menus           Menu[]
  orders          Order[]
  payments        Payment[]
  idempotencyKeys IdempotencyKey[]

  @@map("tenants")
}

model AdminUser {
  id           String    @id @default(cuid())
  tenantId     String    @map("tenant_id")
  email        String
  name         String
  passwordHash String    @map("password_hash")
  role         AdminRole @default(MANAGER)
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  tenant       Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, email])
  @@index([tenantId])
  @@map("admin_users")
}

model Branch {
  id        String            @id @default(cuid())
  tenantId  String            @map("tenant_id")
  name      String
  createdAt DateTime          @default(now())
  updatedAt DateTime          @updatedAt
  tenant    Tenant            @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  tables    RestaurantTable[]
  orders    Order[]
  payments  Payment[]

  @@index([tenantId])
  @@map("branches")
}

model RestaurantTable {
  id        String      @id @default(cuid())
  tenantId  String      @map("tenant_id")
  branchId  String      @map("branch_id")
  name      String
  status    TableStatus @default(AVAILABLE)
  createdAt DateTime    @default(now())
  updatedAt DateTime    @updatedAt
  tenant    Tenant      @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  branch    Branch      @relation(fields: [branchId], references: [id], onDelete: Cascade)
  orders    Order[]

  @@index([tenantId])
  @@index([tenantId, branchId])
  @@map("tables")
}

model Menu {
  id        String      @id @default(cuid())
  tenantId  String      @map("tenant_id")
  name      String
  price     Decimal     @db.Decimal(12, 2)
  imageUrl  String?     @map("image_url") @db.VarChar(500)
  isActive  Boolean     @default(true) @map("is_active")
  createdAt DateTime    @default(now())
  updatedAt DateTime    @updatedAt
  tenant    Tenant      @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  items     OrderItem[]

  @@index([tenantId])
  @@map("menus")
}

model Order {
  id        String            @id @default(cuid())
  tenantId  String            @map("tenant_id")
  branchId  String            @map("branch_id")
  tableId   String            @map("table_id")
  status    OrderStatus       @default(PENDING)
  total     Decimal           @db.Decimal(12, 2)
  createdAt DateTime          @default(now())
  updatedAt DateTime          @updatedAt
  tenant    Tenant            @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  branch    Branch            @relation(fields: [branchId], references: [id], onDelete: Restrict)
  table     RestaurantTable   @relation(fields: [tableId], references: [id], onDelete: Restrict)
  items     OrderItem[]
  payment   Payment?

  @@index([tenantId])
  @@index([tenantId, branchId])
  @@index([tenantId, createdAt])
  @@index([tenantId, branchId, createdAt])
  @@index([tenantId, tableId])
  @@map("orders")
}

model Payment {
  id        String        @id @default(cuid())
  tenantId  String        @map("tenant_id")
  branchId  String        @map("branch_id")
  orderId   String        @unique @map("order_id")
  method    PaymentMethod @default(CASH)
  amount    Decimal       @db.Decimal(12, 2)
  status    PaymentStatus @default(COMPLETED)
  paidAt    DateTime      @default(now()) @map("paid_at")
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt
  tenant    Tenant        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  branch    Branch        @relation(fields: [branchId], references: [id], onDelete: Restrict)
  order     Order         @relation(fields: [orderId], references: [id], onDelete: Restrict)

  @@index([tenantId])
  @@index([tenantId, branchId])
  @@index([tenantId, paidAt])
  @@index([tenantId, branchId, paidAt])
  @@map("payments")
}

model IdempotencyKey {
  id          String            @id @default(cuid())
  tenantId    String            @map("tenant_id")
  action      IdempotencyAction
  key         String            @db.VarChar(128)
  requestHash String            @map("request_hash") @db.Char(64)
  resourceId  String?           @map("resource_id") @db.VarChar(191)
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt
  tenant      Tenant            @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, action, key])
  @@index([tenantId, action])
  @@map("idempotency_keys")
}

model OrderItem {
  id        String   @id @default(cuid())
  orderId   String   @map("order_id")
  menuId    String   @map("menu_id")
  quantity  Int
  unitPrice Decimal  @map("unit_price") @db.Decimal(12, 2)
  createdAt DateTime @default(now())
  order     Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  menu      Menu     @relation(fields: [menuId], references: [id], onDelete: Restrict)

  @@index([orderId])
  @@index([menuId])
  @@map("order_items")
}
