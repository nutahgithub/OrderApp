# Runtime
# NODE_ENV: development | test | production
NODE_ENV=development
# API HTTP port.
PORT=4000

# Database
# Main MySQL database used by Prisma.
DATABASE_URL="mysql://orderapp:orderapp@localhost:3306/orderapp"
# Shadow database used by Prisma migrate dev.
SHADOW_DATABASE_URL="mysql://root:root@localhost:3306/orderapp_shadow"
# Redis URL for cache/rate-limit/realtime supporting infrastructure.
REDIS_URL="redis://localhost:6379"

# Security
# JWT signing secret. Use a long random value outside local development.
JWT_SECRET="change-me-in-local-development"

# Logging
# LOG_LEVEL: debug | info | warn | error
LOG_LEVEL=info

# Audit Log
# AUDIT_LOG_ENABLED: true | false
# false disables audit writes and audit-list queries so core flows do not touch audit_logs.
AUDIT_LOG_ENABLED=true

# Public URLs
# Browser URL for the React app. Used by CORS and QR URL generation.
WEB_APP_URL="http://localhost:5173"
# Public API URL. Used to build locally served upload URLs.
API_PUBLIC_URL="http://localhost:4000"

# Upload Storage
# UPLOAD_STORAGE_PROVIDER: local | minio
UPLOAD_STORAGE_PROVIDER="local"
# Local upload directory and public mount path when UPLOAD_STORAGE_PROVIDER=local.
LOCAL_UPLOAD_DIR="uploads"
LOCAL_UPLOAD_PUBLIC_PATH="/uploads"

# MinIO Storage
# Used when UPLOAD_STORAGE_PROVIDER=minio.
MINIO_ENDPOINT="http://localhost:9000"
MINIO_PUBLIC_URL="http://localhost:9000"
MINIO_ACCESS_KEY="minioadmin"
MINIO_SECRET_KEY="minioadmin"
MINIO_BUCKET="orderapp"
MINIO_REGION="us-east-1"

# Frontend
# Vite exposes only variables prefixed with VITE_ to the browser.
VITE_API_BASE_URL="http://localhost:4000"
